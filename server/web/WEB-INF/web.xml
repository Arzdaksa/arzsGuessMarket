<?xml version="1.0" encoding="UTF-8"?>
<!-- metadata-complete: everything is declared here, so Tomcat does not scan classes for annotations -->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0" metadata-complete="true">

    <display-name>Guess Market Server</display-name>

    <listener>
        <listener-class>server.AppListener</listener-class>
    </listener>

    <filter>
        <filter-name>auth</filter-name>
        <filter-class>server.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>auth</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>login</servlet-name>
        <servlet-class>server.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>login</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>logout</servlet-name>
        <servlet-class>server.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>logout</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>poll</servlet-name>
        <servlet-class>server.PollServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>poll</servlet-name>
        <url-pattern>/poll</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>upload</servlet-name>
        <servlet-class>server.UploadServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>upload</servlet-name>
        <url-pattern>/upload</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>events</servlet-name>
        <servlet-class>server.EventsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>events</servlet-name>
        <url-pattern>/events/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>deposit</servlet-name>
        <servlet-class>server.DepositServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>deposit</servlet-name>
        <url-pattern>/account/deposit</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>chat</servlet-name>
        <servlet-class>server.ChatServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>chat</servlet-name>
        <url-pattern>/chat</url-pattern>
    </servlet-mapping>

    <!-- minutes; a client that stops polling for this long is logged out and its name is freed -->
    <session-config>
        <session-timeout>2</session-timeout>
    </session-config>
</web-app>
