<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="Guess-Market">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="GM-events"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="GM-events">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="GM-event" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="GM-event">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="id"/>
                <xs:element ref="description"/>
                <xs:element ref="comision"/>
                <xs:element ref="GM-options"/>
                <xs:element ref="GM-method"/>
            </xs:sequence>
            <xs:attribute name="name" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="id" type="xs:int"/>

    <xs:element name="description" type="xs:string"/>

    <xs:element name="comision">
        <xs:complexType>
            <xs:simpleContent>
                <xs:extension base="xs:int">
                    <xs:attribute name="type" use="required">
                        <xs:simpleType>
                            <xs:restriction base="xs:string">
                                <xs:enumeration value="on-close"/>
                                <xs:enumeration value="on-purchase"/>
                            </xs:restriction>
                        </xs:simpleType>
                    </xs:attribute>
                </xs:extension>
            </xs:simpleContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="GM-options">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="GM-option" minOccurs="2" maxOccurs="2"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="GM-option" type="xs:string"/>

    <xs:element name="GM-method">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="GM-LMSR"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="GM-LMSR">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="b"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="b" type="xs:int"/>

</xs:schema>
